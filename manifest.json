{
  "manifest_version": 3,
  "name": "X Image Weaver",
  "version": "0.1.0",
  "description": "Stitch split-image posts on X into a single tall image.",
  "minimum_chrome_version": "103",
  "permissions": [],
  "host_permissions": [],
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://*.x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "src/core.js",
        "src/dom.js",
        "src/button.js",
        "src/stitch.js",
        "src/overlay.js",
        "src/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
